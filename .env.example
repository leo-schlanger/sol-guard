# ===========================================
# SolGuard Configuration
# ===========================================
# This file shows all available configuration options.
# Copy to .env and configure for your environment.
#
# Legend:
#   [REQUIRED] - Must be set for the app to work
#   [OPTIONAL] - Nice to have, has defaults
#   [PREMIUM]  - Requires paid service, disabled in zero-budget mode
# ===========================================

# ===========================================
# CORE CONFIGURATION [REQUIRED]
# ===========================================

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
API_HOST=localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database [REQUIRED]
DATABASE_URL=postgresql://solguard:solguard123@localhost:5432/solguard
REDIS_URL=redis://localhost:6379

# Security [REQUIRED - change in production!]
JWT_SECRET=dev-secret-key-change-in-production-please-change-this
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Solana RPC [REQUIRED - free tier works]
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_URL=https://api.devnet.solana.com

# ===========================================
# PREMIUM: AI/ML SERVICES
# These are optional - app works without them
# See docs/TODO_PREMIUM_FEATURES.md for details
# ===========================================

# OpenAI [PREMIUM] - Enables AI contract analysis
# Get key: https://platform.openai.com/api-keys
# Cost: ~$0.03-0.06 per 1K tokens
# OPENAI_API_KEY=sk-your-key-here

# Pinecone Vector DB [PREMIUM] - Enables similarity search
# Get key: https://app.pinecone.io/
# Cost: ~$70/month
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# Anthropic [PREMIUM] - Alternative AI provider
# ANTHROPIC_API_KEY=

# ===========================================
# PREMIUM: ENHANCED RPC PROVIDERS
# Optional - improves performance & rate limits
# ===========================================

# Helius [PREMIUM] - Better rate limits, enhanced APIs
# Get key: https://helius.xyz/
# Cost: $50-500/month
# HELIUS_API_KEY=

# QuickNode [PREMIUM] - Dedicated WebSocket
# Cost: $75-300/month
# QUICKNODE_API_KEY=
# QUICKNODE_WS_URL=

# Geyser gRPC [PREMIUM] - Ultra-low latency
# Cost: $200-1000/month
# GEYSER_GRPC_URL=
# GEYSER_ACCESS_TOKEN=

# ===========================================
# PREMIUM: NFT CERTIFICATION
# Optional - enables real on-chain certificates
# ===========================================

# Authority Keypair [PREMIUM] - For real NFT minting
# Generate: solana-keygen new --outfile authority.json
# Format: JSON array of bytes [1,2,3,...]
# Cost: ~$0.01 per certificate (network fees)
# SOLGUARD_AUTHORITY_PRIVATE_KEY=[]

# IPFS Storage [PREMIUM] - For certificate metadata
# Get key: https://pinata.cloud/
# Cost: ~$5-20/month
# PINATA_API_KEY=
# PINATA_SECRET_KEY=

# NFT.Storage [FREE TIER AVAILABLE]
# Get key: https://nft.storage/
# NFT_STORAGE_API_KEY=

# ===========================================
# PREMIUM: NOTIFICATIONS
# Optional - enables external alerts
# ===========================================

# Slack [FREE with Slack workspace]
# Create app: https://api.slack.com/apps
# SLACK_WEBHOOK_URL=
# SLACK_CHANNEL=#security-alerts

# Email/SMTP [PREMIUM]
# Use SendGrid, Mailgun, or similar
# Cost: ~$10-20/month
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SolGuard <security@solguard.com>

# PagerDuty [PREMIUM]
# Cost: ~$15-40/user/month
# PAGERDUTY_INTEGRATION_KEY=

# ===========================================
# PREMIUM: OBSERVABILITY
# Optional - enables error tracking & APM
# ===========================================

# Sentry [FREE TIER AVAILABLE]
# Get DSN: https://sentry.io/
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Datadog [PREMIUM]
# Cost: ~$15/host/month
# DATADOG_API_KEY=
# DATADOG_APP_KEY=

# ===========================================
# OPTIONAL: PERFORMANCE TUNING
# ===========================================

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Database Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_MAX_CONNECTIONS=100

# File Upload
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug

# ===========================================
# OPTIONAL: EXTERNAL DATA APIS
# These have free tiers
# ===========================================

# CoinGecko (has free tier)
# COINGECKO_API_KEY=

# DeFiLlama (free)
DEFILLAMA_API_URL=https://api.llama.fi

# ===========================================
# ZERO-BUDGET MODE SUMMARY
# ===========================================
# With just the [REQUIRED] variables set, you get:
# ✅ Full risk score calculation
# ✅ Token analysis (metadata, holders, transactions)
# ✅ Pattern-based vulnerability detection
# ✅ User authentication & API access
# ✅ Basic real-time monitoring (100 subscriptions)
# ✅ Mock certificate generation
#
# What's disabled:
# ❌ AI-powered analysis (needs OPENAI_API_KEY)
# ❌ Real NFT certificates (needs authority keypair)
# ❌ External notifications (needs Slack/SMTP)
# ❌ Premium RPC features (needs Helius/QuickNode)
# ===========================================
